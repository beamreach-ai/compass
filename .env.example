# Copy to .env. The AWS profile is read from ~/.aws (mounted read-only).
AWS_PROFILE=default
AWS_REGION=us-east-1
# Dashboard sign-in. Leave both empty and `init_config` generates them (user admin);
# `docker compose run --rm compass login` shows them again.
APP_USERNAME=
APP_PASSWORD=
# GitHub token with repo scope: pull requests go through it (gh auth token prints yours).
GITHUB_TOKEN=
# Optional: Claude for incident summaries and PR replies. Without it Compass runs model-free.
ANTHROPIC_API_KEY=
# Release to run (ghcr.io/beamreach-ai/compass:<version>); COMPASS_IMAGE / COMPASS_DASHBOARD_IMAGE override the references.
# The dashboard says when a newer one is out; the updater service (docker compose --profile updater up -d) rewrites this line.
COMPASS_VERSION=0.4.0
# Updates: stable (default) or prerelease; checks are one request for a public file every 6 hours (COMPASS_UPDATE_CHECK=off stops them).
COMPASS_UPDATE_CHANNEL=stable
# What the updater may do on its own: notify (default; nothing without a click), patch (x.y.Z), minor (x.Y.z), off (no checks either).
COMPASS_AUTO_UPDATE=notify
# Optional: when automatic updates may run, HH:MM-HH:MM in this machine's TZ (manual ones ignore it).
COMPASS_UPDATE_WINDOW=
# Port for the dashboard and the API.
COMPASS_PORT=8080
# Optional: re-scan the map every N seconds (0 = only when you start a scan).
COMPASS_MAP_INTERVAL=0
